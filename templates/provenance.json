{
  "tilefoundry": {
    "commit": "{{TILEFOUNDRY_COMMIT}}",
    "version": "<installed version>",
    "wheel_sha256": "<sha256>"
  },
  "hir": {
    "source": "authored_hir.py",
    "selector": "OperatorModule.kernel"
  },
  "runtime_twin": {
    "source": "runtime_twin.py",
    "selector": "OperatorRuntime.kernel",
    "production_kernel": "src/tileops/kernels/example.py:main",
    "production_symbol": "ExampleKernel"
  },
  "tilefoundry_check": {
    "command": "tilefoundry check ... --json",
    "status": "pending",
    "report": "artifacts/tilefoundry-check.json"
  },
  "analysis": {
    "command": "tilefoundry analyze ... --compute-cost --memory --roofline --timeline --json",
    "status": "pending",
    "report": "artifacts/tilefoundry-analyze.json",
    "finding_id": null
  },
  "schedule": {
    "command": "tilefoundry schedule ... --topology cta --json",
    "status": "pending",
    "report": "artifacts/tilefoundry-schedule.json",
    "finding_id": null
  },
  "decisions": [
    {
      "tilefoundry_evidence": "<analysis or schedule fact>",
      "hir_choice": "<mesh, shard, or storage choice>",
      "kernel_site": "<TileLang symbol or source location>"
    }
  ],
  "primitive_experiments": [
    {
      "bottleneck": "<profiler observation>",
      "primitive": "<lower-level TileLang primitive or intrinsic>",
      "hypothesis": "<expected effect>",
      "control_ms": 0.0,
      "candidate_ms": 0.0,
      "verdict": "pending"
    }
  ]
}
