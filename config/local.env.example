# Copy to .env and set machine-local paths. Shared image defaults live only in
# config/defaults.env; override them here only for an explicit migration test.

export TILEOPS_REPO=/path/to/TileOPs
export TILEFOUNDRY_REPO=/path/to/TileFoundry
export TILEOPS_CACHE_ROOT=/path/to/cache/tileops-runner
export TILEOPS_LOOP_STATE_ROOT=/path/to/tileops-loop-state
export TILEOPS_FOUNDRY_LOOP_ROOT=/path/to/tileops-foundry-loop

# Optional rootless daemon. Leave unset when the normal Docker socket works.
# export TILEOPS_DOCKER_HOST=unix:///path/to/docker.sock
# export TILEOPS_DOCKER_BOOTSTRAP=/path/to/tileops-docker-daemon.sh

# Set for deterministic performance runs. The wrapper pins a worktree's
# persistent container to this GPU at creation time.
export TILEOPS_GPU=1

# The main agent builds a wheel from this exact commit before dispatch. Leave
# unset to use the current TileFoundry HEAD.
# export TILEFOUNDRY_COMMIT=<full-git-commit>
