# Copy to .env and set machine-local paths. Shared image defaults live only in
# config/defaults.env; override them here only for an explicit migration test.

export TILEOPS_REPO=/path/to/TileOPs
export TILEFOUNDRY_REPO=/path/to/TileFoundry
export TILEOPS_CACHE_ROOT=/path/to/cache/tileops-runner
export TILEOPS_LOOP_STATE_ROOT=/path/to/tileops-loop-state
export TILEOPS_FOUNDRY_LOOP_ROOT=/path/to/tileops-foundry-loop

# Pi is started by Foreman in the pane. Leave unset when `pi` is already on PATH;
# set it when the local installation lives outside the pane's PATH.
# export TILEOPS_PI_BIN=/path/to/pi

# Optional rootless daemon. Leave unset when the normal Docker socket works.
# export TILEOPS_DOCKER_HOST=unix:///path/to/docker.sock
# export TILEOPS_DOCKER_BOOTSTRAP=/path/to/tileops-docker-daemon.sh

# Set for deterministic performance runs. Each round container is pinned to
# this GPU and is rebuilt if the requested GPU changes.
export TILEOPS_GPU=1

# Optional provider/model and thinking level passed to Pi by dispatch_round.sh.
# Use anthropic/<claude-model-id> or openai-codex/<gpt-model-id>. Leave unset to
# use the provider and model selected in Pi's own local configuration.
# export TILEOPS_ROUND_MODEL=anthropic/<claude-model-id>
# export TILEOPS_ROUND_EFFORT=xhigh

# Build a wheel from this exact commit before dispatch. Leave unset to fetch
# upstream/main (or origin/main when there is no upstream remote).
# export TILEFOUNDRY_COMMIT=<full-git-commit>
