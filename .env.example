export TILEOPS_REPO=$HOME/TileOPs
export TILEFOUNDRY_REPO=$HOME/TileFoundry
export FOREMAN_REPO=$HOME/foreman
export TILEOPS_WORKTREE_ROOT=$HOME/TileOPs-worktrees

# Optional machine overrides.
# export TILEOPS_GPU=1
# export TILEOPS_CACHE_ROOT=$HOME/.cache/tileops-runner
# export TILEOPS_DOCKER_HOST=unix:///path/to/docker.sock
# export TILEOPS_DOCKER_BOOTSTRAP=/path/to/start-docker-daemon.sh
# Proxy URL variables are inherited from the shell and rewritten for the container's
# host gateway. The rootless Docker daemon in the default setup uses 10.0.2.2.
# export TILEOPS_PROXY_HOST=10.0.2.2
# export TILEOPS_RUNNER_IMAGE=ghcr.io/tile-ai/tileops-runner:cu132-torch2.13-tl-afcebed1-dev
# export TILEOPS_AGENT_IMAGE=tileops-foundry-loop:agent
# export TILEFOUNDRY_COMMIT=<commit>
# export PI_SSH_EXTENSION=/path/to/pi/examples/extensions/ssh.ts
